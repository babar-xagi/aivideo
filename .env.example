# Local development only. Copy this file to .env before starting services.
POSTGRES_DB=english_coach
POSTGRES_USER=english_coach
POSTGRES_PASSWORD=local_development_only
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://english_coach:local_development_only@127.0.0.1:5433/english_coach
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local S3-compatible object storage. Replace these for a hosted provider.
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=english-coach-recordings
S3_ACCESS_KEY_ID=local-english-coach
S3_SECRET_ACCESS_KEY=local-english-coach-secret

# Real English transcription runs in the worker; the model downloads on first use.
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

